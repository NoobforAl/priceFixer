{
  "name": "price-fixer-extension",
  "version": "1.5.2",
  "description": "Exposes charm pricing: shows $5.99 as the $6 it really is",
  "main": "dist/content.js",
  "scripts": {
    "build": "webpack --mode=production",
    "build:firefox": "webpack --mode=production --env browser=firefox",
    "build:all": "npm run build && npm run build:firefox",
    "dev": "webpack --mode=development --watch",
    "dev:firefox": "webpack --mode=development --watch --env browser=firefox",
    "dev:test": "npm run build && node scripts/dev-server.js",
    "dev:test:firefox": "npm run build:firefox && node scripts/dev-server.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"*.css\" \"*.html\"",
    "lint:css:fix": "stylelint \"*.css\" \"*.html\" --fix",
    "css:unused": "node scripts/check-unused-css.js",
    "deps:outdated": "node scripts/check-outdated.js",
    "format": "eslint . --fix && stylelint \"*.css\" \"*.html\" --fix && prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.js\" \"scripts/**/*.js\" \"*.json\" \"src/**/*.json\" \"*.md\" \"docs/**/*.md\" \"*.css\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.js\" \"scripts/**/*.js\" \"*.json\" \"src/**/*.json\" \"*.md\" \"docs/**/*.md\" \"*.css\" \".github/**/*.yml\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "validate": "npm run type-check && npm run lint && npm run lint:css && npm run css:unused && npm run format:check && npm test",
    "package": "npm run build:all && node scripts/package.js",
    "bench": "jest --roots tests/bench --testMatch \"**/*.bench.test.ts\" --silent=false",
    "lint:addon": "web-ext lint --source-dir dist-firefox",
    "firefox": "node scripts/run-firefox.js"
  },
  "keywords": [
    "browser-extension",
    "price",
    "charm-pricing",
    "chrome",
    "firefox"
  ],
  "author": "NoobforAl",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.3.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/webextension-polyfill": "^0.12.6",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "purgecss": "^8.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "web-ext": "^10.8.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.html": [
      "stylelint --fix"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "regex": "^6.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
