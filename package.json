{
  "name": "price-fixer-extension",
  "version": "1.0.0",
  "description": "Exposes charm pricing: shows $5.99 as the $6 it really is",
  "main": "dist/content.js",
  "scripts": {
    "build": "webpack --mode=production",
    "build:firefox": "webpack --mode=production --env browser=firefox",
    "build:all": "npm run build && npm run build:firefox",
    "dev": "webpack --mode=development --watch",
    "dev:firefox": "webpack --mode=development --watch --env browser=firefox",
    "dev:test": "npm run build && node scripts/dev-server.js",
    "dev:test:firefox": "npm run build:firefox && node scripts/dev-server.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm test",
    "package": "npm run build:all && node scripts/package.js"
  },
  "keywords": [
    "browser-extension",
    "price",
    "charm-pricing",
    "chrome",
    "firefox"
  ],
  "author": "NoobforAl",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.7",
    "@types/webextension-polyfill": "^0.12.6",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "regex": "^6.1.0"
  }
}
